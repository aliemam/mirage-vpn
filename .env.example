# dnstt configuration
# Set up DNS records: A record for ns1.yourdomain.com -> server IP (DNS only!)
#                     NS record for d1.yourdomain.com -> ns1.yourdomain.com
DNSTT_DOMAIN=d1.yourdomain.com

# slipstream configuration (legacy DNS tunnel)
SLIPSTREAM_DOMAIN=s.yourdomain.com

# Server IP (for reference)
SERVER_IP=your.server.ip
